local lastTick = tick()

RunService.RenderStepped:Connect(function(dt)
    if fpsCapValue > 0 then
        local targetInterval = 1 / fpsCapValue
        while (tick() - lastTick) < targetInterval do
            task.wait()
        end
        lastTick = tick()
    elseif vsyncEnabled then
        local targetInterval = 1 / 60
        while (tick() - lastTick) < targetInterval do
            task.wait()
        end
        lastTick = tick()
    end

    if not showFpsEnabled then return end
    frameCount = frameCount + 1
    lastUpdate = lastUpdate + dt
    if lastUpdate >= 1 then
        fpsLabel.Text = "FPS: " .. math.floor(frameCount / lastUpdate)
        frameCount = 0
        lastUpdate = 0
    end
end)

-- Safe Wall Check via Raycast
local function isTargetVisible(targetPart, character)
    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return true end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localChar, character}
    raycastParams.IgnoreWater = true

    local success, rayResult = pcall(function()
        return Workspace:Raycast(origin, direction, raycastParams)
    end)

    if not success then return true end
    return rayResult == nil
end

-- X-Ray implementation
local function toggleXRay(enable)
    if enable then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                local isInCharacter = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if player.Character and obj:IsDescendantOf(player.Character) then
                        isInCharacter = true
                        break
                    end
                end
                if not isInCharacter then
                    if originalXrayTransparencies[obj] == nil then
                        originalXrayTransparencies[obj] = obj.Transparency
                    end
                    obj.Transparency = 0.6
                end
            end
        end
    else
        for obj, origTrans in pairs(originalXrayTransparencies) do
            if obj and obj.Parent then
                obj.Transparency = origTrans
            end
        end
        originalXrayTransparencies = {}
    end
end

-- Silent Aim Target Selector
local function getClosestPlayerInFOV()
    local closestTarget = nil
    local shortestDist = fovRadius
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local passTeam = true
            if teamCheckEnabled and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                passTeam = false
            end

            if passTeam then
                local character = player.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local targetPart = character:FindFirstChild(targetPartOption) or character:FindFirstChild("HumanoidRootPart")

                if humanoid and humanoid.Health > 0 and targetPart then
                    local passWall = true
                    if wallCheckEnabled and not isTargetVisible(targetPart, character) then
                        passWall = false
                    end

                    if passWall then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

-- Hook Raycast
local oldRaycast
oldRaycast = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if bulletGlideEnabled and silentAimEnabled and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
        local target = getClosestPlayerInFOV()
        if target then
            if method == "Raycast" then
                local origin = args[1]
                local direction = (target.Position - origin)
                args[2] = direction
            elseif method == "FindPartOnRay" then
                local ray = args[1]
                local direction = (target.Position - ray.Origin)
                args[1] = Ray.new(ray.Origin, direction)
            end
        end
    end

    return oldRaycast(self, unpack(args))
end)

-- RenderStepped handling
RunService.RenderStepped:Connect(function()
    if silentAimEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestPlayerInFOV()
        if target then
            if bulletGlideEnabled then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            else
                local goalCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
                Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 0.35)
            end
        end
    end

    if silentAimEnabled and fovVisible then
        fovCircle.Visible = true
        fovCircle.Radius = fovRadius
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    else
        fovCircle.Visible = false
    end

    if noRecoilEnabled then
        local camera = Workspace.CurrentCamera
        if camera then
            camera.CFrame = CFrame.new(camera.CFrame.Position) * camera.CFrame.Rotation
        end
    end

    if fogRemoved then
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 0
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = 0
                v.Haze = 0
                v.Glare = 0
            end
        end
    end

    if customBrightness then
        Lighting.Brightness = customBrightness
        if customBrightness > 2 then
            Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
            Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        end
    end

    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if speedEnabled then humanoid.WalkSpeed = customSpeed end
            if jumpEnabled then humanoid.JumpPower = customJump; humanoid.UseJumpPower = true end
        end

        if noclipEnabled then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

-- Texture Toggle
local function toggleTextures(remove)
    if remove then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                if originalTextures[obj] == nil then originalTextures[obj] = obj.Transparency end
                obj.Transparency = 1
            elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
                if originalTextures[obj] == nil then originalTextures[obj] = {Material = obj.Material, Color = obj.Color} end
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = Color3.fromRGB(150, 150, 150)
            end
        end
    else
        for obj, data in pairs(originalTextures) do
            if obj and obj.Parent then
                if obj:IsA("Texture") or obj:IsA("Decal") then obj.Transparency = data
                elseif obj:IsA("BasePart") then obj.Material = data.Material; obj.Color = data.Color end
            end
        end
        originalTextures = {}
    end
end

-- ESP
local function removeESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do pcall(function() obj:Remove() end) end
        espObjects[player] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)

    local drawings = {
        Box = Drawing.new("Square"), Tracer = Drawing.new("Line"),
        HealthBg = Drawing.new("Square"), HealthBar = Drawing.new("Square"),
    }

    drawings.Box.Visible = false
    drawings.Box.Thickness = 1
    drawings.Box.Filled = false
    drawings.Tracer.Visible = false
    drawings.Tracer.Thickness = 1
    drawings.HealthBg.Visible = false
    drawings.HealthBg.Filled = true
    drawings.HealthBg.Color = Color3.fromRGB(0, 0, 0)
    drawings.HealthBar.Visible = false
    drawings.HealthBar.Filled = true

    espObjects[player] = drawings

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not player.Parent or not espObjects[player] then
            for _, obj in pairs(drawings) do pcall(function() obj.Visible = false end) end
            if not espEnabled then removeESP(player); connection:Disconnect() end
            return
        end

        if teamCheckEnabled and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            for _, obj in pairs(drawings) do obj.Visible = false end
            return
        end

        local character = player.Character
        local localChar = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 and localChar and localChar:FindFirstChild("HumanoidRootPart") then
            local rootPart = character.HumanoidRootPart
            local localRoot = localChar.HumanoidRootPart
            local humanoid = character.Humanoid

            local distance = (localRoot.Position - rootPart.Position).Magnitude
            if distance > maxEspDistance then
                for _, obj in pairs(drawings) do obj.Visible = false end
                return
            end

            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                local humRootScreen, humVis = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 3, 0))
                local legScreen, legVis = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3.5, 0))

                if humVis and legVis then
                    local height = math.abs(humRootScreen.Y - legScreen.Y)
                    local width = height / 2
                    local posX = humRootScreen.X - width / 2
                    local posY = humRootScreen.Y

                    local isVisible = false
                    if visibleColorEsp and character:FindFirstChild("Head") then isVisible = isTargetVisible(character.Head, character) end
                    local activeColor = isVisible and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 255)

                    if boxEspEnabled then
                        drawings.Box.Size = Vector2.new(width, height)
                        drawings.Box.Position = Vector2.new(posX, posY)
                        drawings.Box.Color = activeColor
                        drawings.Box.Visible = true
                    else
                        drawings.Box.Visible = false
                    end

                    if tracerEspEnabled then
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(humRootScreen.X, legScreen.Y)
                        drawings.Tracer.Color = activeColor
                        drawings.Tracer.Visible = true
                    else
                        drawings.Tracer.Visible = false
                    end

                    if healthBarEspEnabled then
                        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        local barHeight = height * healthPercent
                        drawings.HealthBg.Size = Vector2.new(4, height + 2)
                        drawings.HealthBg.Position = Vector2.new(posX - 6, posY - 1)
                        drawings.HealthBg.Visible = true
                        drawings.HealthBar.Size = Vector2.new(2, barHeight)
                        drawings.HealthBar.Position = Vector2.new(posX - 5, posY + (height - barHeight))
                        drawings.HealthBar.Color = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), 1 - healthPercent)
                        drawings.HealthBar.Visible = true
                    else
                        drawings.HealthBg.Visible = false
                        drawings.HealthBar.Visible = false
                    end
                else
                    for _, obj in pairs(drawings) do obj.Visible = false end
                end
            else
                for _, obj in pairs(drawings) do obj.Visible = false end
            end
        else
            for _, obj in pairs(drawings) do obj.Visible = false end
        end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do createESP(player) end
