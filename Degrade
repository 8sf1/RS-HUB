-- ==================== MAIN RENDER LOOP ====================
RunService.RenderStepped:Connect(function(dt)
    if CONFIG.FullBright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end

    if CONFIG.ShowFOV then
        fovCircle.Visible = true
        fovCircle.Radius = CONFIG.FOVSize
        fovCircle.Position = UserInputService:GetMouseLocation()
    else
        fovCircle.Visible = false
    end

    if CONFIG.EnableSpeed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = CONFIG.SpeedAmount
    end

    if CONFIG.EnableSpider and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {char}
            local result = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 3, rayParams)
            if result and result.Instance then
                hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 35, hrp.AssemblyLinearVelocity.Z)
            end
        end
    end

    if CONFIG.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- Render Cached Ores
    if CONFIG.OreESP then
        local playerPos = Camera.CFrame.Position
        for obj, data in pairs(trackedOres) do
            if data.part and data.part.Parent then
                local dist = (playerPos - data.part.Position).Magnitude
                
                if dist <= CONFIG.OreMaxDistance then
                    if data.highlight and not data.highlight.Enabled then
                        data.highlight.Enabled = true
                    end
                    
                    local screenPos, onScreen = Camera:WorldToViewportPoint(data.part.Position)
                    if onScreen then
                        local txt = getOrCreateWorldDrawing(obj)
                        txt.Visible = true
                        txt.Text = string.format("%s [%.0fm]", data.label, dist)
                        txt.Position = Vector2.new(screenPos.X, screenPos.Y)
                    else
                        if worldEspCache[obj] then worldEspCache[obj].Visible = false end
                    end
                else
                    if data.highlight and data.highlight.Enabled then
                        data.highlight.Enabled = false
                    end
                    if worldEspCache[obj] then worldEspCache[obj].Visible = false end
                end
            else
                removeOre(obj)
            end
        end
    end

    -- PLAYER ESP
    if not CONFIG.ESPEnabled then
        for _, drawings in pairs(espCache) do hideDrawings(drawings) end
        return
    end

    local activeKeys = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")

            if rootPart and head then
                if not CONFIG.TeamCheck or player.Team ~= LocalPlayer.Team then
                    local isDead = isPlayerDead(humanoid, char)
                    local isSleeping = isPlayerSleeping(char)

                    local skipPlayer = false
                    if CONFIG.DeadCheck and not isDead then skipPlayer = true
                    elseif not CONFIG.DeadCheck and isDead then skipPlayer = true end
                    if isSleeping and not CONFIG.SleepingESP then skipPlayer = true end

                    if not skipPlayer then
                        local dist = (Camera.CFrame.Position - rootPart.Position).Magnitude
                        if dist <= CONFIG.MaxDistance then
                            activeKeys[player] = true
                            local drawings = getOrCreateDrawings(player)

                            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

                            if onScreen and drawings then
                                local height = math.abs(headPos.Y - legPos.Y)
                                local width = height * 0.5
                                local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

                                if CONFIG.BoxESP and drawings.Box then
                                    drawings.Box.Visible = true
                                    drawings.Box.Size = Vector2.new(width, height)
                                    drawings.Box.Position = boxPos
                                    local col = CONFIG.Rainbow and Color3.fromHSV(tick() % 5 / 5, 1, 1) or Color3.fromRGB(255, 255, 255)
                                    if isSleeping then col = Color3.fromRGB(0, 150, 255) elseif isDead then col = Color3.fromRGB(255, 0, 0) end
                                    drawings.Box.Color = col
                                elseif drawings.Box then drawings.Box.Visible = false end

                                local statusTag = ""
                                if isSleeping then statusTag = " [Sleeping]" elseif isDead then statusTag = " [Dead]" end

                                if CONFIG.NameESP and drawings.Name then
                                    drawings.Name.Visible = true
                                    drawings.Name.Text = player.Name .. statusTag
                                    drawings.Name.Position = Vector2.new(rootPos.X, headPos.Y - 18)
                                elseif drawings.Name then drawings.Name.Visible = false end

                                if CONFIG.DistanceESP and drawings.Distance then
                                    drawings.Distance.Visible = true
                                    drawings.Distance.Text = string.format("[%.0fm]", dist)
                                    drawings.Distance.Position = Vector2.new(rootPos.X, legPos.Y + 2)
                                elseif drawings.Distance then drawings.Distance.Visible = false end

                                if CONFIG.HealthESP and drawings.Health and humanoid then
                                    drawings.Health.Visible = true
                                    drawings.Health.Text = string.format("HP: %.0f", humanoid.Health)
                                    drawings.Health.Position = Vector2.new(rootPos.X, legPos.Y + 14)
                                elseif drawings.Health then drawings.Health.Visible = false end

                                if CONFIG.WeaponESP and drawings.Weapon then
                                    drawings.Weapon.Visible = true
                                    drawings.Weapon.Text = string.format("Held: %s", getEquippedWeapon(char))
                                    drawings.Weapon.Position = Vector2.new(rootPos.X, legPos.Y + 26)
                                elseif drawings.Weapon then drawings.Weapon.Visible = false end

                                if CONFIG.TracerESP and drawings.Tracer then
                                    drawings.Tracer.Visible = true
                                    drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                    drawings.Tracer.To = Vector2.new(rootPos.X, legPos.Y)
                                elseif drawings.Tracer then drawings.Tracer.Visible = false end

                                if CONFIG.SkeletonESP and drawings.Skeletons then
                                    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                                    local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                                    local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                                    local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                                    local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                                    if head and torso and leftArm and rightArm and leftLeg and rightLeg then
                                        local hPos = Camera:WorldToViewportPoint(head.Position)
                                        local tPos = Camera:WorldToViewportPoint(torso.Position)
                                        local lA = Camera:WorldToViewportPoint(leftArm.Position)
                                        local rA = Camera:WorldToViewportPoint(rightArm.Position)
                                        local lL = Camera:WorldToViewportPoint(leftLeg.Position)
                                        local rL = Camera:WorldToViewportPoint(rightLeg.Position)

                                        local joints = { {hPos, tPos}, {tPos, lA}, {tPos, rA}, {tPos, lL}, {tPos, rL} }
                                        for i, joint in ipairs(joints) do
                                            local line = drawings.Skeletons[i]
                                            if line then
                                                line.Visible = true
                                                line.From = Vector2.new(joint[1].X, joint[1].Y)
                                                line.To = Vector2.new(joint[2].X, joint[2].Y)
                                            end
                                        end
                                    else
                                        for _, line in ipairs(drawings.Skeletons) do line.Visible = false end
                                    end
                                else
                                    if drawings.Skeletons then
                                        for _, line in ipairs(drawings.Skeletons) do line.Visible = false end
                                    end
                                end
                            else
                                hideDrawings(drawings)
                            end
                        else
                            hideDrawings(espCache[player])
                        end
                    end
                end
            end
        end
    end

    for key, drawings in pairs(espCache) do
        if not activeKeys[key] then hideDrawings(drawings) end
    end
end)

Rayfield:LoadConfiguration()
