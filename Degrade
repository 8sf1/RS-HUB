local function isPlayerDead(humanoid, character)
    if not character then return false end
    if humanoid and humanoid.Health <= 0 then return true end
    if character:GetAttribute("IsDead") == true or character:GetAttribute("Dead") == true or character:GetAttribute("Knocked") == true then return true end
    if not character:FindFirstChild("HumanoidRootPart") then return true end
    return false
end

local function isPlayerSleeping(character)
    if not character then return false end
    if character:GetAttribute("IsSleeping") == true or character:GetAttribute("Sleeping") == true or character:FindFirstChild("Sleeping") then return true end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and (humanoid.PlatformStand or humanoid.Sit) and not character:FindFirstChild("HumanoidRootPart") then return true end
    return false
end

-- ==================== STRICT ORE MATCHER ====================
local function isTargetOre(obj, selectedOre)
    local name = obj.Name:lower()
    local sel = selectedOre:lower()
    
    local ignoreWords = {"wall", "floor", "building", "furniture", "door", "window", "prop", "decor", "base", "house", "structure", "gate", "fence", "roof", "terrain", "part", "brick", "glass", "wood"}
    for _, word in ipairs(ignoreWords) do
        if name:find(word) then return false end
    end

    local hasPrompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector")
    local hasHealth = obj:FindFirstChild("Health") or obj:FindFirstChild("Durability")
    local isNodeName = name:find("node") or name:find("ore") or name:find("vein") or name:find("deposit") or name:find("mineral") or name:find("rock")
    
    if not (hasPrompt or hasHealth or isNodeName) then return false end

    local function matchString(str)
        if sel:find("stone") and str:find("stone") then return true end
        if sel:find("metal") and (str:find("metal") or str:find("iron") or str:find("scrap") or str:find("copper")) then return true end
        if sel:find("sulfur") and (str:find("sulfur") or str:find("sulphur")) then return true end
        return false
    end

    if matchString(name) then return true end

    local attr = obj:GetAttribute("OreType") or obj:GetAttribute("Type") or obj:GetAttribute("Resource")
    if attr and matchString(tostring(attr):lower()) then return true end

    if obj:IsA("Model") then
        for _, child in ipairs(obj:GetChildren()) do
            if matchString(child.Name:lower()) then return true end
        end
    end

    return false
end

-- ==================== EVENT-DRIVEN ORE CACHE ====================
local trackedOres = {}

local function addOre(obj)
    if trackedOres[obj] then return end
    
    local label = CONFIG.SelectedOre
    if isTargetOre(obj, label) then
        local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if part then
            local hl = Instance.new("Highlight")
            hl.Name = "RS_OreOutline"
            hl.Adornee = obj
            hl.FillTransparency = 1 
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.OutlineColor = Color3.fromRGB(255, 215, 0)
            hl.Enabled = false
            hl.Parent = obj
            
            trackedOres[obj] = {
                instance = obj,
                part = part,
                highlight = hl,
                label = label
            }
        end
    end
end

local function removeOre(obj)
    if trackedOres[obj] then
        if trackedOres[obj].highlight then
            trackedOres[obj].highlight:Destroy()
        end
        trackedOres[obj] = nil
    end
    
    local txt = worldEspCache[obj]
    if txt then
        txt:Remove()
        worldEspCache[obj] = nil
    end
end

local function rebuildOreCache()
    for obj, _ in pairs(trackedOres) do
        removeOre(obj)
    end
    
    if not CONFIG.OreESP then return end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            addOre(obj)
        end
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if CONFIG.OreESP and (obj:IsA("Model") or obj:IsA("BasePart")) then
        addOre(obj)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if trackedOres[obj] then
        removeOre(obj)
    end
end)

