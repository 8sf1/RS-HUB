            Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / math.max(CONFIG.Smoothness, 1))
        end
    end

    if not CONFIG.ESPEnabled then
        for _, drawings in pairs(espCache) do
            hideDrawings(drawings)
        end
        return
    end

    local activeKeys = {}
    local targets = getValidTargets()

    for _, t in ipairs(targets) do
        local character = t.Model
        local rootPart = t.Root
        
        if character and rootPart and rootPart.Parent and t.Humanoid and t.Humanoid.Health > 0 then
            activeKeys[t.Key] = true
            local drawings = getOrCreateDrawings(t.Key)
            
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
            
            if onScreen and rootPos.Z > 0 and distance < 1000 then
                local currentESPColor = getActiveESPColor()

                local headPart = character:FindFirstChild("Head") or rootPart
                local topPos, topOnScreen = Camera:WorldToViewportPoint(headPart.Position + Vector3.new(0, 0.8, 0))
                local botPos, botOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 2.2, 0))
                
                if topOnScreen or botOnScreen then
                    local height = math.abs(topPos.Y - botPos.Y)
                    if height < 15 or height > 400 then height = 50 end
                    local width = height * 0.55
                    local boxPos = Vector2.new(rootPos.X - width / 2, topPos.Y)
                    
                    if CONFIG.BoxESP then
                        drawings.Box.Visible = true
                        drawings.Box.Size = Vector2.new(width, height)
                        drawings.Box.Position = boxPos
                        drawings.Box.Color = currentESPColor
                    else
                        drawings.Box.Visible = false
                    end
                    
                    if CONFIG.TracerESP then
                        drawings.Tracer.Visible = true
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(rootPos.X, botPos.Y)
                        drawings.Tracer.Color = currentESPColor
                    else
                        drawings.Tracer.Visible = false
                    end
                    
                    if CONFIG.HealthBar and t.Humanoid.MaxHealth > 0 then
                        local healthPercent = math.clamp(t.Humanoid.Health / t.Humanoid.MaxHealth, 0, 1)
                        local barHeight = height * healthPercent
                        
                        drawings.HealthBarBg.Visible = true
                        drawings.HealthBarBg.From = Vector2.new(boxPos.X - 6, boxPos.Y + height)
                        drawings.HealthBarBg.To = Vector2.new(boxPos.X - 6, boxPos.Y)
                        
                        drawings.HealthBar.Visible = true
                        drawings.HealthBar.From = Vector2.new(boxPos.X - 6, boxPos.Y + height)
                        drawings.HealthBar.To = Vector2.new(boxPos.X - 6, boxPos.Y + (height - barHeight))
                        drawings.HealthBar.Color = Color3.fromHSV(healthPercent * 0.33, 1, 1)
                    else
                        drawings.HealthBar.Visible = false
                        drawings.HealthBarBg.Visible = false
                    end
                    
                    if CONFIG.NameESP then
                        drawings.Name.Visible = true
                        drawings.Name.Text = tostring(t.Name)
                        drawings.Name.Position = Vector2.new(rootPos.X, topPos.Y - 16)
                        drawings.Name.Color = currentESPColor
                    else
                        drawings.Name.Visible = false
                    end
                    
                    if CONFIG.DistanceESP and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        drawings.Distance.Visible = true
                        drawings.Distance.Text = string.format("[%.0fm]", distance)
                        drawings.Distance.Position = Vector2.new(rootPos.X, botPos.Y + 2)
                        drawings.Distance.Color = currentESPColor
                    else
                        drawings.Distance.Visible = false
                    end
                else
                    hideDrawings(drawings)
                end
            else
                hideDrawings(drawings)
            end
        end
    end

    for key, drawings in pairs(espCache) do
        if not activeKeys[key] then
            hideDrawings(drawings)
            removeDrawings(key)
        end
    end
end))

