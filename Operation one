-- ==================== CORE DRAWING & TARGETING LOGIC ====================
local function getOrCreateDrawings(key)
    if not espCache[key] then
        espCache[key] = {
            Box = Drawing.new("Square"),
            Tracer = Drawing.new("Line"),
            HealthBarBg = Drawing.new("Line"),
            HealthBar = Drawing.new("Line"),
            Name = Drawing.new("Text"),
            Distance = Drawing.new("Text")
        }
        local d = espCache[key]
        d.Box.Thickness = 1
        d.Box.Filled = false
        d.Tracer.Thickness = 1
        d.HealthBarBg.Thickness = 3
        d.HealthBarBg.Color = Color3.fromRGB(0, 0, 0)
        d.HealthBar.Thickness = 1
        d.Name.Size = 14
        d.Name.Center = true
        d.Name.Outline = true
        d.Distance.Size = 12
        d.Distance.Center = true
        d.Distance.Outline = true
    end
    return espCache[key]
end

local function hideDrawings(drawings)
    for _, d in pairs(drawings) do
        d.Visible = false
    end
end

local function removeDrawings(key)
    if espCache[key] then
        for _, drawing in pairs(espCache[key]) do
            pcall(function() drawing:Remove() end)
        end
        espCache[key] = nil
    end
end

local function getTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
end

local function isVisible(targetPart, character)
    if not CONFIG.WallCheck then return true end
    local localChar = LocalPlayer.Character
    if not localChar or not targetPart then return true end

    local origin = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = targetPos - origin

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localChar}
    raycastParams.IgnoreWater = true

    local result = workspace:Raycast(origin, direction, raycastParams)
    
    if not result then 
        return true 
    end

    if result.Instance:IsDescendantOf(character) or (result.Position - targetPos).Magnitude < 3.5 then
        return true
    end

    return false
end

local function getActiveESPColor()
    if CONFIG.RGBEnabled then
        local hue = (tick() % 4) / 4
        return Color3.fromHSV(hue, 1, 1)
    else
        return CONFIG.ESPColor
    end
end

local function isValidEnemy(model)
    if not model:IsA("Model") or model == LocalPlayer.Character then return false end
    
    local nameLower = model.Name:lower()
    if nameLower:find("defuser") or nameLower:find("bomb") or nameLower:find("item") or nameLower:find("ammo") or nameLower:find("prop") or nameLower:find("car") or nameLower:find("spawn") or nameLower:find("zone") or nameLower:find("objective") or nameLower:find("effect") then
        return false
    end
    
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
    local headPart = model:FindFirstChild("Head")
    
    if not humanoid or not rootPart or not headPart then return false end
    if humanoid.Health <= 0 then return false end
    
    return true
end

local function getValidTargets()
    local targets = {}
    
    local function scanInstance(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Model") then
                if isValidEnemy(obj) then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    table.insert(targets, {Model = obj, Part = getTargetPart(obj) or root, Key = obj, Name = obj.Name, Humanoid = hum, Root = root})
                end
            elseif obj:IsA("Folder") then
                scanInstance(obj)
            end
        end
    end
    
    scanInstance(workspace)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and root and hum and hum.Health > 0 then
                table.insert(targets, {Model = char, Part = getTargetPart(char) or root, Key = player, Name = player.Name, Humanoid = hum, Root = root})
            end
        end
    end
    
    return targets
end

local function getClosestTarget()
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        return nil
    end

    local targetPart = nil
    local shortestDist = CONFIG.FovRadius
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, t in ipairs(getValidTargets()) do
        if t.Part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(t.Part.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist <= CONFIG.FovRadius and dist < shortestDist then
                    if isVisible(t.Part, t.Model) then
                        shortestDist = dist
                        targetPart = t.Part
                    end
                end
            end
        end
    end
    return targetPart
end

-- ==================== MAIN RENDER LOOP ====================
table.insert(activeConnections, RunService.RenderStepped:Connect(function()
