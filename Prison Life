-- ============ CAMERA LOGIC ============

track(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel and Config.Camera.Noclip then
        CurrentZoom = math.clamp(CurrentZoom - input.Position.Z * 2, 1, 50)
    end
end))

local function updateCamera(dt)
    local char, hrp, hum = getCharacter()
    if not char or not hrp or not hum then return end

    if not Config.Camera.Noclip and not Config.Camera.Freecam then
        if IsCameraOverridden then
            Camera.CameraType = Enum.CameraType.Custom
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            hum.WalkSpeed = Config.Movement.SpeedEnabled and Config.Movement.SpeedValue or 16
            hum.JumpPower = 50
            IsCameraOverridden = false
        end
        return
    end

    IsCameraOverridden = true
    Camera.CameraType = Enum.CameraType.Scriptable

    if Config.Camera.Freecam then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        
        local delta = UserInputService:GetMouseDelta()
        CamYaw = CamYaw - delta.X * 0.005
        CamPitch = math.clamp(CamPitch - delta.Y * 0.005, -math.pi/2 + 0.1, math.pi/2 - 0.1)
        
        local rotation = CFrame.Angles(0, CamYaw, 0) * CFrame.Angles(CamPitch, 0, 0)
        FreecamCFrame = CFrame.new(FreecamCFrame.Position) * rotation
        
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + rotation.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - rotation.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - rotation.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + rotation.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then
            FreecamCFrame = FreecamCFrame + (moveDir.Unit * Config.Camera.FreecamSpeed * dt)
        end
        
        Camera.CFrame = FreecamCFrame
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

    elseif Config.Camera.Noclip then
        hum.WalkSpeed = Config.Movement.SpeedEnabled and Config.Movement.SpeedValue or 16
        hum.JumpPower = 50
        
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            local delta = UserInputService:GetMouseDelta()
            CamYaw = CamYaw - delta.X * 0.005
            CamPitch = math.clamp(CamPitch - delta.Y * 0.005, -math.pi/2 + 0.1, math.pi/2 - 0.1)
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
        
        local head = char:FindFirstChild("Head") or hrp
        local headPos = head.Position
        local rotation = CFrame.Angles(0, CamYaw, 0) * CFrame.Angles(CamPitch, 0, 0)
        
        local camPos = headPos - (rotation.LookVector * CurrentZoom)
        Camera.CFrame = CFrame.new(camPos) * rotation
        
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(rotation.LookVector.X, 0, rotation.LookVector.Z))
    end
end

-- ============ XRAY & BUILDINGS ============

local function toggleXRay(state)
    if state then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsDescendantOf(LocalPlayer.Character) then
                local isPlayerPart = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and v:IsDescendantOf(plr.Character) then
                        isPlayerPart = true
                        break
                    end
                end
                if not isPlayerPart then
                    if not XRayParts[v] then XRayParts[v] = v.LocalTransparencyModifier end
                    v.LocalTransparencyModifier = 0.5
                end
            end
        end
    else
        for v, trans in pairs(XRayParts) do
            if v and v.Parent then v.LocalTransparencyModifier = trans end
        end
        XRayParts = {}
    end
end

local function removePartsByKeyword(keyword)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find(keyword) and not obj:IsDescendantOf(LocalPlayer.Character) then
                if obj:IsA("BasePart") then
                    if not RemovedParts[obj] then
                        RemovedParts[obj] = { Transparency = obj.Transparency, CanCollide = obj.CanCollide }
                        obj.Transparency = 1
                        obj.CanCollide = false
                        count = count + 1
                    end
                elseif obj:IsA("Model") then
                    for _, part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") and not RemovedParts[part] then
                            RemovedParts[part] = { Transparency = part.Transparency, CanCollide = part.CanCollide }
                            part.Transparency = 1
                            part.CanCollide = false
                            count = count + 1
                        end
                    end
                end
            end
        end
    end
    Rayfield:Notify({Title = "Removed", Content = "Removed " .. count .. " objects matching '" .. keyword .. "'", Duration = 3})
end

local function restoreAllBuildings()
    local count = 0
    for part, data in pairs(RemovedParts) do
        if part and part.Parent then
            part.Transparency = data.Transparency
            part.CanCollide = data.CanCollide
            count = count + 1
        end
    end
    RemovedParts = {}
    Rayfield:Notify({Title = "Restored", Content = "Restored " .. count .. " objects.", Duration = 3})
end

-- ============ TELEPORT & MOVEMENT LOGIC ============

local function teleportToLocation(pos)
    local char, hrp = getCharacter()
    if not hrp or not char then return end
    
    local wasNoclip = Config.Movement.PhaseEnabled
    if not wasNoclip then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end

    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    
    task.delay(0.5, function()
        if not wasNoclip and not Config.Movement.PhaseEnabled then
            local currentChar = LocalPlayer.Character
            if currentChar then
                for _, v in ipairs(currentChar:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = true end
                end
            end
        end
    end)
end

local function teleportToWeapon(weaponName, isPolice)
    local char, hrp = getCharacter()
    if not hrp or not char then return end

    local giverFolder = Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("giver")
    if not giverFolder then return end

    local bestModel = nil
    local shortestDist = math.huge
    local basePos = isPolice and Vector3.new(830, 99, 2272) or Vector3.new(-946, 94, 2055)

    for _, v in ipairs(giverFolder:GetChildren()) do
        if v.Name == weaponName then
            local pos = v:GetPivot().Position
            local dist = (pos - basePos).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                bestModel = v
            end
        end
    end

    if not bestModel then return end

    local pickupPad = bestModel:FindFirstChild("ITEMPICKUP")
    local targetPos = pickupPad and pickupPad.Position or bestModel:GetPivot().Position
    
    if weaponName == "FAL" then targetPos = Vector3.new(-899, 93.5, 2046)
    elseif weaponName == "C4 Explosive" then targetPos = Vector3.new(-900, 94.5, 2041)
    elseif weaponName == "Revolver" and not isPolice then targetPos = Vector3.new(-916, 95.5, 2038) end

    local wasNoclip = Config.Movement.PhaseEnabled
    if not wasNoclip then
        for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end

    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
    hrp.AssemblyLinearVelocity = Vector3.new(0, -15, 0)
    
    task.delay(0.5, function()
        if not wasNoclip and not Config.Movement.PhaseEnabled then
            local currentChar = LocalPlayer.Character
            if currentChar then for _, v in ipairs(currentChar:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = true end end end
        end
    end)
end

local function applyPlayerMovement()
    local char, hrp, hum = getCharacter()
    if not char or not hrp or not hum then return end

    if Config.Camera.Freecam then return end

    if Config.Movement.PhaseEnabled and not hum.SeatPart then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDir * Config.Movement.PhaseSpeed)
        end
    end

    if hum.SeatPart then
        if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
        return
    end

    if Config.Movement.SpeedEnabled then 
        hum.WalkSpeed = Config.Movement.SpeedValue
    elseif hum.WalkSpeed == Config.Movement.SpeedValue then 
        hum.WalkSpeed = 16 
    end

    if Config.Movement.FlyEnabled then
        if not FlyBodyVel or not FlyBodyVel.Parent then
            FlyBodyVel = Instance.new("BodyVelocity")
            FlyBodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            FlyBodyVel.Velocity = Vector3.zero
            FlyBodyVel.Parent = hrp
        end
        hum.PlatformStand = true
        
        local camCF = Camera.CFrame
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then FlyBodyVel.Velocity = moveDir.Unit * Config.Movement.FlySpeed
        else FlyBodyVel.Velocity = Vector3.zero end
    else
        if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
    end
end

local function applyVehicleCustomization()
    local vehicle = getVehicle()
    if not vehicle then
        Rayfield:Notify({Title = "Error", Content = "You must be sitting in a vehicle.", Duration = 3})
        return
    end

    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if not name:find("wheel") and not name:find("window") and not name:find("seat") and part.Transparency < 0.5 then
                part.Color = Config.Vehicles.Color
            end
        end
    end

    if Config.Vehicles.DecalId ~= "" then
        local body = vehicle:FindFirstChild("Body") or vehicle.PrimaryPart
        if body then
            local existing = body:FindFirstChild("CustomDecal")
            if existing then existing:Destroy() end
            local decal = Instance.new("Decal")
            decal.Name = "CustomDecal"
            decal.Texture = "rbxassetid://" .. Config.Vehicles.DecalId
            decal.Face = Enum.NormalId.Top
            decal.Parent = body
        end
    end
end

local function updateVehicleRainbow()
    if not Config.Vehicles.Rainbow then return end
    if tick() - LastRainbowUpdate < 0.1 then return end
    LastRainbowUpdate = tick()

    local vehicle = getVehicle()
    if not vehicle then return end
    
    local hue = (tick() * 0.5) % 1
    local rainbowColor = Color3.fromHSV(hue, 1, 1)
    
    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if not name:find("wheel") and not name:find("window") and not name:find("seat") and part.Transparency < 0.5 then
                part.Color = rainbowColor
            end
        end
    end
end

track(RunService.RenderStepped:Connect(function(dt)
    if Unloaded then return end
    
    if Camera.FieldOfView ~= Config.Camera.FOV then
        Camera.FieldOfView = Config.Camera.FOV
    end

    applyPlayerMovement()
    updateVehicleRainbow()
    updateCamera(dt)
end))

