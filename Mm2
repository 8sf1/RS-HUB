-- ============ HELPERS ============

local function getCharacter(plr)
    local char = plr.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return nil end
    return char, hrp, hum
end

local function getRole(plr)
    local char = plr.Character
    local backpack = plr.Backpack
    if not char then return "Innocent" end
    
    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murderer"
    elseif char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver"))) then
        return "Sheriff"
    else
        return "Innocent"
    end
end

local function getLocalRole()
    return getRole(LocalPlayer)
end

local function isValidCandy(item)
    if not item or not item.Parent then return false end
    if not item:IsA("BasePart") then return false end
    
    local name = item.Name:lower()
    if not (name:find("candy") or name:find("coin")) then return false end
    if item.Transparency >= 0.95 then return false end 
    if item.Anchored and item.Size.Magnitude > 25 then return false end
    
    return true
end

