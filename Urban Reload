ESPTab:CreateToggle({ Name = "Box", CurrentValue = false, Callback = function(v) Config.ESP.Box = v end })
ESPTab:CreateToggle({ Name = "Name", CurrentValue = false, Callback = function(v) Config.ESP.Name = v end })
ESPTab:CreateToggle({ Name = "Health", CurrentValue = false, Callback = function(v) Config.ESP.Health = v end })
ESPTab:CreateToggle({ Name = "Distance", CurrentValue = false, Callback = function(v) Config.ESP.Distance = v end })
ESPTab:CreateToggle({ Name = "Tracer", CurrentValue = false, Callback = function(v) Config.ESP.Tracer = v end })
ESPTab:CreateToggle({ Name = "Visible Tracer (Orange)", CurrentValue = false, Callback = function(v) Config.ESP.VisibleTracer = v end })
ESPTab:CreateToggle({ Name = "Team Check", CurrentValue = false, Callback = function(v) Config.ESP.TeamCheck = v end })
ESPTab:CreateSlider({ Name = "Max Distance", Range = {50, 5000}, Increment = 50, Suffix = "m", CurrentValue = 1000, Callback = function(v) Config.ESP.MaxDistance = v end })
